# Copy to .env (in this folder) and fill in your own values. Never commit .env.
PORTKEY_API_KEY=your-portkey-api-key-here
# Signs login session cookies; any long random string (e.g. `python3 -c "import secrets;print(secrets.token_hex(32))"`)
SESSION_SECRET=change-me-to-a-long-random-string
# Optional: override the model (default gpt-5.6-luna through Portkey)
# CC_MODEL=gpt-5.6-luna
